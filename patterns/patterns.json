{
  "smtp_sent": {
    "base": {
      "separator": "^(?P<time>\\d{2}:\\d{2}:\\d{2})"
    },
    "patterns": {
      "default": "(?P<time>\\d{2}:\\d{2}:\\d{2})\\s+NORMAL\\s+Job:\\s*(?P<Jobnummer>\\d+)\\s+\\[(?P<Profile>[^\\]]+)\\]\\s+Start to send response nr\\.\\s+(?P<ResponseNr>\\d+)\\s+by SMTP.*?Recipient=(?P<Empfaenger>[^\\)\\s,]*)"
    }
  },
  "sql_exceptions": {
    "base": {
      "separator": "^(?P<time>\\d{2}:\\d{2}:\\d{2})"
    },
    "patterns": {
      "sql_exception": "(?s)exception on sql statement:\\s*(?P<sql_query>.+?)\\s*\\(transformed to.*?java\\.sql\\.[^:]+:\\s*(?P<error_details>.*?)(?:\\s+for statement|$).*?Caused by:\\s*java\\.sql\\.[^:]+:\\s*(?P<caused_by>[^\\n]*)",
      "check_failed_for_db": "(?s)check failed for alias\\s+(?P<check_failed_for>'.*?').*?Caused by:\\s*java\\.net\\.[^:]+:\\s*(?P<caused_by>[^\\n]*)"
    }
  },
  "db_pool_size_exceeded": {
    "base": {
      "separator": "^(?P<time>\\d{2}:\\d{2}:\\d{2})"
    },
    "patterns": {
      "default": "(?s)alias\\s+(?P<alias>\\w+):\\s+pool size already exceeded\\s+(?P<max_pool_size_for_connection>\\d+)\\.\\s+Total connections:\\s+(?P<total_connections_made>\\d+)"
    }
  },
  "ftp_per_profile": {
    "base": {
      "separator": "^(?P<time>\\d{2}:\\d{2}:\\d{2})"
    },
    "patterns": {
      "default": "Job:\\s*(?P<Job>\\d+)\\s+\\[(?P<Profile>[^\\]]+)\\].*?Start to send response.*?by FTP.*?Comm\\.Channel=(?P<Channel>[^,]+).*?file=(?P<File>[^\\s\\)]+)"
    }
  },
  "http_requests_jasperserver": {
    "base": {
      "separator": "^.*?\\[(?P<time>\\d{2}/\\w{3}/\\d{4}:\\d{2}:\\d{2}:\\d{2})"
    },
    "patterns": {
      "default": "^(?P<ip>(?!127.0.0.1)\\S+)\\s(?P<logname>\\S+)\\s(?P<user>\\S+)\\s\\[(?P<timestamp>\\d{2}/\\w{3}/\\d{4}:\\d{2}:\\d{2}:\\d{2})\\s(?P<timezone>[^\\]]+)\\]\\s\"(?P<method>[A-Z]+)\\s(?P<path>\\S+)\\sHTTP\\/(?P<protocol>\\d\\.\\d)\"\\s(?P<status>\\d{3})\\s(?P<size>\\d+)\\s(?P<duration>\\d+)$"
    }
  },
  "http_requests_general": {
    "base": {
      "separator": "^.*?\\[(?P<time>\\d{2}/\\w{3}/\\d{4}:\\d{2}:\\d{2}:\\d{2})"
    },
    "patterns": {
      "default": "^(?P<ip>(?!127\\.0\\.0\\.1)\\S+)\\s(?P<identity>\\S+)\\s(?P<user>\\S+)\\s\\[(?P<timestamp>\\d{2}/\\w{3}/\\d{4}:\\d{2}:\\d{2}:\\d{2})\\s(?P<timezone>[^\\]]+)\\]\\s\"(?P<method>[A-Z]+)\\s(?P<path>\\S+)\\sHTTP/(?P<protocol>\\d\\.\\d)\"\\s(?P<status>\\d{3})\\s(?P<size>[\\d-]+)\\s\"(?P<referer>[^\"]*)\"\\s\"(?P<user_agent>[^\"]*)\"$"
    }
  },
  "catalina_out_jasperserver": {
    "base": {
      "separator": "^(\\d{2}-\\w{3}-\\d{4}|\\d{4}-\\d{2}-\\d{2}T)"
    },
    "patterns": {
      "catalina_out_severe": "(?P<time>\\d{2}-\\w{3}-\\d{4}\\s[\\d:.]+)\\s+(?P<Severity>SEVERE)\\s+\\[(?P<Header>[^\\]]+)\\]\\s+(?P<Message>[^\\r\\n]+)(?:[\\s\\S]*?Caused by:\\s+(?P<Cause>[^\\r\\n]+))?",
      "catalina_out_error": "(?P<time>\\d{4}-\\d{2}-\\d{2}T[\\d:,]+)\\s+(?P<Severity>ERROR)\\s+(?P<Header>[\\w,:-]+)\\s+-\\s+(?P<Message>[^\\r\\n]+)(?:[\\s\\S]*?Caused by:\\s+(?P<Cause>[^\\r\\n]+))?"
    }
  },
  "lobster_ftp_sessions": {
    "base": {
      "separator": "^(?P<time>\\d{2}:\\d{2}:\\d{2})"
    },
    "patterns": {
      "default": "(?P<time>\\d{2}:\\d{2}:\\d{2})\\s+NORMAL\\s+FtpDaemon@\\S+\\s+Ftp-session\\s+finished\\s+from\\s+ip\\s+(?P<ip>[\\d.]+),\\s+user\\s+'(?P<user>[^']+)'\\s+for\\s+session\\s+(?P<session>\\S+)"
    }
  },
  "lobster_log": {
    "base": {
      "separator": "^(?P<time>\\d{2}:\\d{2}:\\d{2})"
    },

    "patterns": {
      "uncaught_exception": "(?s)^(?P<time>\\d{2}:\\d{2}:\\d{2})\\s+UNCAUGHTEXCEPTIONHANLDER:.*?Thread\\[(?P<thread>[^\\]]+)\\].*?\\n(?P<exception>java\\.[^\\n]+)\\n(?P<stacktrace>(?:\\s+at\\s+.*\\n)+)",

      "sql_exception_full": "(?s)^(?P<time>\\d{2}:\\d{2}:\\d{2})\\s+SYSTEM:DATABASE:CONNECTIONPROXY\\((?P<connection_id>[a-f0-9]+)\\) exception on sql statement:\\s*(?P<sql_query>.+?)\\s*\\(transformed to\\s*(?P<transformed_query>.+?)\\)\\s*(?P<exception_class>com\\.[^:]+|java\\.[^:]+):\\s*(?P<error_message>.*?)\\n(?P<stacktrace>(?:\\s+at\\s+.*\\n)+)",

      "sql_exception_simple": "(?s)(?P<exception_class>java\\.sql\\.[^:]+):\\s*(?P<error_message>[^\\n]+)",

      "sql_error_code_ibm": "\\[(?P<sql_code>SQL\\d{4})\\]\\s*(?P<error_text>[^\\.]+)",

      "sql_parameters": "(?P<prefix>Param for failed sql statement) \\[(?P<param_index>\\d+):(?P<param_type>[a-z])\\]\\s+'(?P<param_value>.*?)'",

      "next_exception_chain": "(?s)Next exception in (?P<exception_type>[^:]+):\\s*(?P<nested_exception>java\\.sql\\.[^:]+)",

      "constraint_violation": "(?s)\\[(?P<sql_code>SQL0530)\\].*?Integritätsbedingung\\s+(?P<constraint>\\S+)",

      "duplicate_key_sqlserver": "(?s)SQLServerException:.*PRIMARY KEY.*?Wert ist \\((?P<duplicate_key>[^\\)]+)\\)",

      "table_not_found": "(?s)Table\\s+'(?P<table>[^']+)'\\s+doesn't exist",

      "cursor_prepare_exception": "(?s)cursorresult exception on prepare for '\\s*(?P<sql_query>.*?)':\\s*(?P<exception_class>java\\.sql\\.[^:]+):\\s*(?P<error_message>[^\\n]+)",

      "syntax_error_as400": "(?s)(?P<exception_class>com\\.ibm\\.as400\\.access\\.AS400JDBCSQLSyntaxErrorException):\\s*\\[(?P<sql_code>SQL\\d{4})\\]\\s*(?P<message>[^\\n]+)",

      "data_conversion_error": "(?s)\\[(?P<sql_code>SQL0802)\\]\\s*(?P<message>Fehler bei Datenumsetzung[^\\n]+)",

      "network_timeout": "(?s)Exception while trying to call remote partner at\\s+(?P<url>http[^,]+),.*?\\n(?P<exception>java\\.net\\.SocketTimeoutException):\\s*(?P<message>[^\\n]+)",

      "malformed_url": "(?s)Exception while trying to call remote partner at\\s+(?P<url>http[^,]+),.*?\\n(?P<exception>java\\.net\\.MalformedURLException):\\s*(?P<message>[^\\n]+)",

      "caused_by": "(?s)Caused by:\\s*(?P<exception>java\\.[^:]+):\\s*(?P<message>[^\\n]+)",

      "smtp_no_action": "SYSTEM:SMTP:SMTPSERVICE:\\s+no action found for address\\(es\\)\\s+'(?P<email>[^']+)'",

      "message_lifetime_exceeded": "(?s)MESSAGEQUEUE.*?ignoring message, life time exceeded, message=(?P<message_details>Message \\[.*?\\])",

      "amqp_session_closed": "(?s)Failed to create producer for alias\\s+'(?P<alias>[^']+)' .*?\\njava\\.util\\.concurrent\\.ExecutionException:\\s*(?P<root_exception>[^:]+):\\s*(?P<message>[^\\n]+)",

      "generic_stacktrace": "(?s)(?P<exception>java\\.[^\\n]+)\\n(?P<stacktrace>(?:\\s+at\\s+.*\\n)+)"
    }
  }
}
